# The settings of one club's Booster Rocket (deploy/compose.yml). Copy this file to deploy/.env, fill in every line
# that is empty, and keep the copy private (chmod 600 .env) and safe: keep a copy of it with your backups, somewhere
# other than this machine. Never commit it. docs/runbooks/first-install.md walks through each line.
#
# A line left empty that the portal needs stops `docker compose up` with a message naming it. Nothing here has a
# default that could pass for a real value: the addresses, passwords and keys are the club's own.
#
# Make each password and key on this machine, one at a time, and paste it in:
#   openssl rand -hex 32        a password or secret (letters a-f and digits only, so it is safe inside an address)
#   openssl rand -base64 32     SETTINGS_ENCRYPTION_KEY only

# ---------------------------------------------------------------------------------------------------------------------
# The portal's image
# ---------------------------------------------------------------------------------------------------------------------

# The published image, from the GitHub Container Registry: ghcr.io/<owner>/booster-rocket:<tag>, where <owner> is the
# GitHub account the portal's repository belongs to, written in lower case, and <tag> is stable (the newest release;
# updated by pulling) or a release's version, like 1.0.0 (stays put until you change it here).
#   BOOSTER_ROCKET_IMAGE=ghcr.io/<owner>/booster-rocket:stable
# Leave it empty when you build the image here with compose.build.yml (until a release is published, or to run a
# change not yet released): that file names the image itself.
BOOSTER_ROCKET_IMAGE=

# ---------------------------------------------------------------------------------------------------------------------
# Addresses and time
# ---------------------------------------------------------------------------------------------------------------------

# The portal's own address, the one parents and staff type: https://portal.example.org
# Only the address: https, the name, a port if it has one. No path, and no slash at the end. Sign-in, the links in emails,
# the address QuickBooks returns to and the installed app are all built on it. If it changes later, change the
# redirect addresses at Microsoft or Google and at Intuit too.
APP_URL=

# Documenso's address, where forms are signed: https://sign.example.org
# A name of its own (not a path under the portal's), with no slash at the end. Exactly this address is the one browsers must use: signing is
# refused under any other name, scheme or port. The portal's Forms settings page takes this same address.
DOCUMENSO_URL=

# The club's time zone, an IANA name such as America/Chicago or America/New_York. The nightly backup runs at BACKUP_AT
# in it, and the servers' logs use it. (What parents read as due follows the zone set on the staff Club page: set it
# there too.)
CLUB_TIME_ZONE=

# Which request header says where a visitor is coming from. It must be a header the proxy in front of the portal sets
# itself, replacing whatever the visitor sent; any other can be typed by a visitor. .env.example at the top of the
# repository explains the choices. In short:
#   x-forwarded-for    with this file's own proxy (docker compose --profile proxy), and behind most others
#   cf-connecting-ip   behind a tunnel or proxy service that sets that header
#   none               nothing you control is in front: every address is recorded as unknown
# Find out what your proxy sets rather than guessing (docs/runbooks/first-install.md, "A proxy of your own").
CLIENT_IP_HEADER=

# ---------------------------------------------------------------------------------------------------------------------
# The database server
# ---------------------------------------------------------------------------------------------------------------------

# Three passwords, each its own: openssl rand -hex 32. They are set when Postgres first starts, on an empty volume, and
# changing one here later does not change it in Postgres (docs/runbooks/first-install.md, "Changing a password").
# Postgres's own administrator. The nightly backup uses it to read both databases.
POSTGRES_SUPERUSER_PASSWORD=
# The portal's database role (booster).
PORTAL_DB_PASSWORD=
# Documenso's database role (documenso).
DOCUMENSO_DB_PASSWORD=

# ---------------------------------------------------------------------------------------------------------------------
# The portal's secrets
# ---------------------------------------------------------------------------------------------------------------------

# Signs the session cookies of both doors (staff and parents); the worker's token is made from it. Changing it signs
# everyone out. openssl rand -hex 32
BETTER_AUTH_SECRET=

# Encrypts the secrets the portal stores in its database: the QuickBooks connection, the staff sign-in certificate and
# secret, the mail password, Documenso's API token. openssl rand -base64 32
# Without it a restored database can't be read where it matters. Keep it with the backups.
SETTINGS_ENCRYPTION_KEY=

# The key before SETTINGS_ENCRYPTION_KEY was last changed. Leave it empty until a key is first changed. Once parents
# have authenticator apps, keep it for good after a change: each app is sealed again under the new key the next time
# its holder signs in with it, and one not used since needs the old key (docs/runbooks/backups.md).
SETTINGS_ENCRYPTION_KEY_PREVIOUS=

# ---------------------------------------------------------------------------------------------------------------------
# Documenso
# ---------------------------------------------------------------------------------------------------------------------

# Documenso's own secrets: three more, each openssl rand -hex 32. Keep them with the backups (a restored Documenso works
# without them, but its staff would have to sign in again and set up two-step sign-in again).
DOCUMENSO_NEXTAUTH_SECRET=
DOCUMENSO_ENCRYPTION_KEY=
DOCUMENSO_ENCRYPTION_SECONDARY_KEY=

# The signing certificate Documenso seals every signed form with: the full path on this machine to the .p12 file, and
# its passphrase. docs/runbooks/documenso.md says how to make one and renew it. Keep both with the backups, together:
# without them a restored Documenso can't finish signing a form.
#   DOCUMENSO_SIGNING_CERTIFICATE=/srv/booster-rocket/documenso-signing.p12
DOCUMENSO_SIGNING_CERTIFICATE=
DOCUMENSO_SIGNING_PASSPHRASE=

# Documenso's own account mail (confirming the first account, password resets, inviting staff), through SMTP.
# It sends no mail about forms. docs/runbooks/mail.md has the values for Microsoft 365 and for other mail services.
DOCUMENSO_SMTP_HOST=
# 587 with STARTTLS (DOCUMENSO_SMTP_SECURE=false), or 465 with TLS from the start (DOCUMENSO_SMTP_SECURE=true).
DOCUMENSO_SMTP_PORT=
DOCUMENSO_SMTP_SECURE=false
DOCUMENSO_SMTP_USERNAME=
DOCUMENSO_SMTP_PASSWORD=
# The address and name Documenso's mail comes from: forms@example.org, "Example Boosters forms".
DOCUMENSO_SMTP_FROM_ADDRESS=
DOCUMENSO_SMTP_FROM_NAME=

# A trusted time on each signature: off by default, and the club's owner hasn't decided yet.
#   Left empty: a signature's time is this server's clock, and sealing a form needs nothing outside this machine.
#   Set to one or more timestamp services' addresses (comma-separated): each signature carries a time from that
#   service, which PDF readers can trust; a hash of every document is sent to it; and sealing waits for it,
#   so an outage of more than six hours leaves signed forms unsealed until staff ask Documenso again.
DOCUMENSO_TIMESTAMP_AUTHORITY=

# Sign-up stays closed (true). Set it to false only for the few minutes it takes to make the first Documenso account,
# then back to true (docs/runbooks/documenso.md).
DOCUMENSO_DISABLE_SIGNUP=true

# Optional: staff sign in to Documenso with the club's own sign-in (OpenID Connect). docs/runbooks/documenso.md.
DOCUMENSO_OIDC_WELL_KNOWN=
DOCUMENSO_OIDC_CLIENT_ID=
DOCUMENSO_OIDC_CLIENT_SECRET=
DOCUMENSO_OIDC_PROVIDER_LABEL=
DOCUMENSO_OIDC_SKIP_VERIFY=

# Only when the portal's name resolves to a private address from this machine (a portal reachable only on the club's
# own network): the portal's host name, so Documenso may send its webhook there. Leave it empty otherwise.
DOCUMENSO_WEBHOOK_PRIVATE_HOSTS=

# ---------------------------------------------------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------------------------------------------------

# The folder on this machine the nightly backup writes to, outside this checkout: /srv/booster-rocket/backups
# Copy it somewhere other than this machine as well (docs/runbooks/backups.md).
BACKUP_DIR=
# The time of day, in CLUB_TIME_ZONE, on a 24-hour clock. Choose one that exists every day (not between 01:00 and
# 03:00 in a zone whose clocks change then). "off" when the host's own scheduler runs the backups instead.
BACKUP_AT=03:00
# How many backups of each database to keep.
BACKUP_KEEP=14

# ---------------------------------------------------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------------------------------------------------

# Where a proxy of the club's own on this machine reaches the portal and Documenso: http://127.0.0.1:<port>.
# Nothing outside this machine can reach these ports.
PORTAL_LOCAL_PORT=3000
DOCUMENSO_LOCAL_PORT=3001

# With this file's own proxy (--profile proxy): the ports it answers on. Leave 80 and 443 for a real installation;
# both must reach this machine from the internet for the certificates.
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
