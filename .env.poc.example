# The env file of a Booster Rocket server run with docker compose (docker-compose.poc.yml).
# scripts/poc/setup.sh copies this to .env.poc, private (chmod 600). Never commit .env.poc, and keep a copy of it with
# your backups. setup.sh fills in APP_URL from the address you give it, and BETTER_AUTH_SECRET, DB_PASSWORD and
# SETTINGS_ENCRYPTION_KEY with fresh random values. .env.example says what each value is for.

# The portal's own address, the one people type: https://portal.yourclub.org
APP_URL=
BETTER_AUTH_SECRET=
DB_PASSWORD=
SETTINGS_ENCRYPTION_KEY=

# The request header that carries a visitor's address. Leave it out behind Cloudflare; .env.example lists the others.
# CLIENT_IP_HEADER=cf-connecting-ip

# Staff sign-in and outgoing mail are set up in the portal itself, at /setup after the first deploy; QuickBooks and
# parent sign-ins under Settings, once an Admin has signed in.
