# Pull request previews' poll (docs/superpowers/specs/2026-11-27-pr-previews-design.md). Not installed: the owner
# decides when. A user unit: copy this file and the .timer beside it into ~/.config/systemd/user/, then
# systemctl --user daemon-reload && systemctl --user enable --now booster-rocket-preview-poll.timer
[Unit]
Description=Boosters Rocket pull request previews: sweep closed ones, bring up the ones the owner labeled

[Service]
Type=oneshot
WorkingDirectory=%h/booster-rocket
ExecStart=%h/booster-rocket/scripts/poc/preview.sh poll
Nice=10
IOSchedulingClass=idle
